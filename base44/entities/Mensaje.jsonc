{
  "name": "Mensaje",
  "type": "object",
  "properties": {
    "usuario_email": {
      "type": "string",
      "title": "Email del Usuario"
    },
    "usuario_nombre": {
      "type": "string",
      "title": "Nombre del Usuario"
    },
    "texto": {
      "type": "string",
      "title": "Texto"
    },
    "es_admin": {
      "type": "boolean",
      "title": "Es Admin",
      "default": false
    },
    "leido": {
      "type": "boolean",
      "title": "Le\u00eddo",
      "default": false
    }
  },
  "required": [
    "usuario_email",
    "texto"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.usuario_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.usuario_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}