{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "title": "Rol"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "activo"
      ],
      "default": "pendiente",
      "title": "Estado de acceso"
    },
    "link_titulo": {
      "type": "string",
      "title": "T\u00edtulo del enlace"
    },
    "valor_contado": {
      "type": "number",
      "title": "Valor Contado",
      "default": 0
    },
    "valor_cuenta": {
      "type": "number",
      "title": "Valor a Cuenta",
      "default": 0
    },
    "whatsapp_telefono": {
      "type": "string",
      "title": "Tel\u00e9fono WhatsApp"
    },
    "whatsapp_apikey": {
      "type": "string",
      "title": "API Key CallMeBot"
    }
  },
  "required": [
    "link_titulo"
  ]
}