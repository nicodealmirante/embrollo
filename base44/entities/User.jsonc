{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "activo"
      ],
      "default": "pendiente"
    },
    "nombre_visible": {
      "type": "string",
      "title": "Nombre Visible"
    },
    "link_titulo": {
      "type": "string",
      "title": "T\u00edtulo del enlace"
    },
    "valor_contado": {
      "type": "number",
      "title": "Valor Contado",
      "default": 0
    },
    "valor_cuenta": {
      "type": "number",
      "title": "Valor a Cuenta",
      "default": 0
    },
    "simplepush_key": {
      "type": "string",
      "title": "SimplePush Key"
    },
    "telefono": {
      "type": "string",
      "title": "Tel\u00e9fono (WhatsApp)",
      "description": "Con c\u00f3digo de pa\u00eds, sin + ni espacios. Ej: 5491123456789"
    },
    "contador_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "contador_fin": {
      "type": "string",
      "format": "date-time"
    },
    "contador_estado": {
      "type": "string",
      "enum": [
        "activo",
        "vencido",
        "pausado_manual",
        "inactivo"
      ],
      "default": "inactivo"
    }
  },
  "required": [
    "link_titulo",
    "simplepush_key",
    "telefono"
  ]
}