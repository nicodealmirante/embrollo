{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "estado": {
      "type": "string",
      "enum": [
        "activo",
        "pendiente"
      ],
      "default": "pendiente"
    },
    "link_titulo": {
      "type": "string",
      "title": "T\u00edtulo del enlace"
    },
    "link_token": {
      "type": "string",
      "title": "Token de enlace"
    },
    "valor_contado": {
      "type": "number",
      "title": "Valor Contado",
      "default": 0
    },
    "valor_cuenta": {
      "type": "number",
      "title": "Valor a Cuenta",
      "default": 0
    },
    "simplepush_key": {
      "type": "string",
      "title": "SimplePush Key"
    }
  }
}