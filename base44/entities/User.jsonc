{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "title": "Rol",
      "default": "user"
    },
    "multiplicador": {
      "type": "number",
      "title": "Multiplicador",
      "default": 1
    },
    "valor_contado": {
      "type": "number",
      "title": "Valor Contado",
      "default": 0
    },
    "valor_cuenta": {
      "type": "number",
      "title": "Valor a Cuenta",
      "default": 0
    },
    "link_token": {
      "type": "string",
      "title": "Token de Enlace"
    },
    "link_titulo": {
      "type": "string",
      "title": "T\u00edtulo del Enlace"
    }
  }
}