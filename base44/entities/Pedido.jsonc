{
  "name": "Pedido",
  "type": "object",
  "properties": {
    "usuario_email": {
      "type": "string",
      "title": "Email del Usuario"
    },
    "usuario_nombre": {
      "type": "string",
      "title": "Nombre del Usuario"
    },
    "fecha": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "confirmado",
        "entregado",
        "cancelado"
      ],
      "title": "Estado",
      "default": "pendiente"
    },
    "tipo_pago": {
      "type": "string",
      "enum": [
        "contado",
        "cuenta"
      ],
      "title": "Tipo de Pago",
      "default": "cuenta"
    },
    "cantidad": {
      "type": "number",
      "title": "Cantidad",
      "default": 1
    },
    "valor_usado": {
      "type": "number",
      "title": "Valor Unitario Usado",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "observaciones": {
      "type": "string",
      "title": "Observaciones"
    }
  },
  "required": [
    "usuario_email",
    "fecha",
    "estado",
    "cantidad",
    "tipo_pago"
  ]
}