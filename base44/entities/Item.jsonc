{
  "name": "Item",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "title": "Nombre"
    },
    "descripcion": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "precio_contado": {
      "type": "number",
      "title": "Precio Contado (entrega)",
      "default": 0
    },
    "precio_cuenta": {
      "type": "number",
      "title": "Precio a Cuenta (diferido)",
      "default": 0
    },
    "activo": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    },
    "imagen": {
      "type": "string",
      "title": "Imagen URL"
    },
    "orden": {
      "type": "number",
      "title": "Orden",
      "default": 0
    }
  },
  "required": [
    "nombre"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.activo": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": null
  }
}