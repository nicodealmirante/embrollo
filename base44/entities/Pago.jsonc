{
  "name": "Pago",
  "type": "object",
  "properties": {
    "usuario_email": {
      "type": "string",
      "title": "Email del Usuario"
    },
    "usuario_nombre": {
      "type": "string",
      "title": "Nombre del Usuario"
    },
    "fecha": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha"
    },
    "monto": {
      "type": "number",
      "title": "Monto"
    },
    "metodo": {
      "type": "string",
      "enum": [
        "efectivo",
        "transferencia",
        "tarjeta",
        "otro"
      ],
      "title": "M\u00e9todo de Pago"
    },
    "referencia": {
      "type": "string",
      "title": "Referencia"
    },
    "observaciones": {
      "type": "string",
      "title": "Observaciones"
    },
    "comprobante_url": {
      "type": "string",
      "title": "URL del Comprobante"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "aprobado",
        "rechazado"
      ],
      "title": "Estado",
      "default": "aprobado"
    },
    "origen": {
      "type": "string",
      "enum": [
        "admin",
        "usuario"
      ],
      "title": "Origen",
      "default": "admin"
    }
  },
  "required": [
    "usuario_email",
    "fecha",
    "monto",
    "metodo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.usuario_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.usuario_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}