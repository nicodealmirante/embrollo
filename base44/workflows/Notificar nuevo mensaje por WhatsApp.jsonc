{
  "name": "Notificar nuevo mensaje por WhatsApp",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.es_admin == false) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Mensaje"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_nuevo_mensaje_por_whatsapp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarMensajeWA",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notificarMensajeWA"
  }
}